# ==============================================================================
# HOME CREDIT AI VOICE AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Add your OpenRouter API Key below (https://openrouter.ai/keys)
# 3. Specify the model you wish to use (e.g. google/gemini-2.0-flash-001 or anthropic/claude-3.5-haiku)
# 4. Restart the backend server.
#
# NOTE: The API key is securely loaded on the backend only and is NEVER exposed
# to the frontend, browser, or client network logs.
# ==============================================================================

# OpenRouter API Key (Required for live LLM conversational engine)
OPENROUTER_API_KEY=

# OpenRouter Model Identifier
# Common supported choices:
# - google/gemini-2.0-flash-001
# - meta-llama/llama-3.3-70b-instruct
# - anthropic/claude-3.5-haiku
# - openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Backend server port
PORT=3001
